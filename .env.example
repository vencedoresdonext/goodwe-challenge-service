# ========================
# Application
# ========================
NODE_ENV=development
PORT=3000
API_PREFIX=api
LOG_LEVEL=debug

# ========================
# Database (MySQL & Prisma)
# ========================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=goodwe
DB_USER=root
DB_PASSWORD=change-me
# Parâmetros úteis: connection_limit=10&pool_timeout=20  |  remoto com TLS: sslaccept=strict
DATABASE_URL="mysql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?connection_limit=10"

# ========================
# Redis
# ========================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false # true para provedores gerenciados

# ========================
# JWT
# ========================
JWT_APP_SECRET=change-me-app-secret
JWT_WEB_SECRET=change-me-web-secret
JWT_APP_REFRESH_SECRET=change-me-app-refresh-secret
JWT_WEB_REFRESH_SECRET=change-me-web-refresh-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ========================
# Rate limiting (ttl em ms)
# ========================
THROTTLE_TTL_SHORT=1000
THROTTLE_LIMIT_SHORT=30
THROTTLE_TTL_MEDIUM=10000
THROTTLE_LIMIT_MEDIUM=150
THROTTLE_TTL_LONG=60000
THROTTLE_LIMIT_LONG=600

# ========================
# Mercado Pago
# ========================
MERCADO_PAGO_BASE_URL=https://api.mercadopago.com
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_PIX_EXPIRATION_MINUTES=30

# ========================
# Telemetry API
# ========================
TELEMETRY_API_URL=https://mock-telemetry-api.goodwe.com/v1
TELEMETRY_API_KEY=
