generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  phone     String?    @unique
  fullName  String?    @db.VarChar(150)
  password  String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  roles     UserRole[]

  cards             CustomerCard[]
  transactions      PaymentTransaction[]
  chargerSessions   ChargerSession[]
  chargersToReceive Charger[]            @relation("ChargerReceiver")
  vehicles          Vehicle[]

  @@map("users")
}

model Role {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  users     UserRole[]

  @@map("roles")
}

model UserRole {
  userId String
  roleId Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model CustomerCard {
  id             String   @id @default(uuid())
  userId         String
  gatewayToken   String
  lastFourDigits String   @db.VarChar(4)
  brand          String   @db.VarChar(20)
  holderName     String   @db.VarChar(100)
  expiresAt      DateTime
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions      PaymentTransaction[]
  chargersToReceive Charger[]            @relation("ChargerReceiverCard")

  @@index([userId])
  @@map("customer_cards")
}

model PaymentTransaction {
  id                   String    @id @default(uuid())
  userId               String
  chargerSessionId     String?   @unique
  idempotencyKey       String    @unique
  paymentMethodId      Int
  statusId             Int
  amountCents          Int
  discountCents        Int       @default(0)
  finalAmountCents     Int
  gatewayTransactionId String?
  pixPayload           String?   @db.Text
  pixTxId              String?
  pixExpiresAt         DateTime?
  customerCardId       String?
  failureReason        String?   @db.Text
  gatewayMetadata      String?   @db.Text
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  paymentMethod  PaymentMethod     @relation(fields: [paymentMethodId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  statusEnum     TransactionStatus @relation(fields: [statusId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  chargerSession ChargerSession?   @relation(fields: [chargerSessionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customerCard   CustomerCard?     @relation(fields: [customerCardId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId])
  @@index([gatewayTransactionId])
  @@index([pixTxId])
  @@map("payment_transactions")
}

model ChargerSession {
  id                       String    @id @default(uuid())
  userId                   String
  vehicleId                String?
  chargerId                String
  statusId                 Int
  preAuthorizedAmountCents Int       @default(0)
  consumedAmountCents      Int       @default(0)
  energyDeliveredKwh       Float     @default(0)
  startedAt                DateTime?
  finishedAt               DateTime?
  idleStartedAt            DateTime?
  lastBatteryPercentage    Int?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  statusEnum  ChargerSessionStatus @relation(fields: [statusId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle     Vehicle?             @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  charger     Charger              @relation(fields: [chargerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  transaction PaymentTransaction?

  @@index([userId])
  @@index([chargerId])
  @@map("charger_sessions")
}

model Charger {
  id               String   @id @default(uuid())
  receiverUserId   String
  receiverCardId   String?
  pricePerKwhCents Int      @default(85)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  receiverUser User              @relation("ChargerReceiver", fields: [receiverUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  receiverCard CustomerCard?     @relation("ChargerReceiverCard", fields: [receiverCardId], references: [id], onDelete: SetNull)
  connector    StationConnector?
  sessions     ChargerSession[]

  @@index([receiverUserId])
  @@map("chargers")
}

model ChargerSessionStatus {
  id   Int    @id
  name String @unique

  sessions ChargerSession[]

  @@map("charger_session_statuses")
}

model PaymentMethod {
  id   Int    @id
  name String @unique

  transactions PaymentTransaction[]

  @@map("payment_methods")
}

model TransactionStatus {
  id   Int    @id
  name String @unique

  transactions PaymentTransaction[]

  @@map("transaction_statuses")
}

model Vehicle {
  id        String   @id @default(uuid())
  userId    String
  plate     String   @db.VarChar(10)
  brand     String   @db.VarChar(50)
  model     String   @db.VarChar(50)
  icon      String   @default("sedan") @db.VarChar(30)
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions ChargerSession[]

  @@unique([userId, plate])
  @@index([userId])
  @@map("vehicles")
}

model Station {
  id                       String   @id @default(uuid())
  name                     String   @db.VarChar(150)
  address                  String   @db.VarChar(255)
  latitude                 Float
  longitude                Float
  pricePerKwhCents         Int      @default(85)
  contractedDemandKw       Float    @default(100.0)
  currentConsumptionKw     Float    @default(0.0)
  currentSolarGenerationKw Float    @default(0.0)
  isActive                 Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  connectors StationConnector[]

  @@index([latitude, longitude])
  @@map("stations")
}

model StationConnector {
  id            String   @id @default(uuid())
  stationId     String
  chargerId     String   @unique
  connectorType String   @db.VarChar(30)
  maxPowerKw    Float    @default(22.0)
  statusId      Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  station    Station         @relation(fields: [stationId], references: [id], onDelete: Cascade)
  charger    Charger         @relation(fields: [chargerId], references: [id], onDelete: Cascade)
  statusEnum ConnectorStatus @relation(fields: [statusId], references: [id])

  @@index([stationId])
  @@map("station_connectors")
}

model ConnectorStatus {
  id   Int    @id
  name String @unique

  connectors StationConnector[]

  @@map("connector_statuses")
}
